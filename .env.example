DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"
PORT=3000

# JWT — Segredo usado para assinar os tokens (use um valor longo e aleatório em produção)
JWT_SECRET="troque-para-um-segredo-forte-em-producao"

# Tempo de expiração do access token (formato aceito pelo jose: "15m", "1h", "7d")
JWT_EXPIRES_IN="15m"

# Tempo de expiração do refresh token em dias
REFRESH_TOKEN_EXPIRES_IN_DAYS=7
